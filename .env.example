# Local development. For deployment set APP_ENV=production and
# BASE_URL=https://getkontracts.app. See docs/DEPLOYMENT.md.
APP_ENV=development
BASE_URL=http://localhost:8000
APP_SECRET=
DATA_DIR=./data

# Four public identities on one domain. See docs/EMAIL_SETUP.md.
# No provider key: development saves .eml files in data/mail/ (nothing is sent).
# Production requires a provider. Support needs a receiving inbox/forwarder.
MAIL_ENABLED=true
MAIL_SENDER_DOMAIN=getkontracts.app
MAIL_ACCOUNTS_FROM="Kontracts <accounts@getkontracts.app>"
MAIL_NOTIFICATIONS_FROM="Kontracts <notifications@getkontracts.app>"
MAIL_BILLING_FROM="Kontracts Billing <billing@getkontracts.app>"
SUPPORT_EMAIL=support@getkontracts.app
MAIL_REPLY_TO=support@getkontracts.app
RESEND_API_KEY=
# Use SMTP only as an alternative to Resend's API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_BILLING_NOTICES=true
MAIL_DAILY_LIMIT=90
MAIL_31DAY_LIMIT=2700
MAIL_SEND_INTERVAL=0.6

# One recurring USD 49/month software subscription.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=

# Leave blank for in-person-only detailers. Square is optional.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Production business identity and reviewed policy files.
LEGAL_NAME=
LEGAL_ADDRESS=
LEGAL_TERMS_PATH=
LEGAL_PRIVACY_PATH=
LEGAL_REVIEW_CONFIRMED=false
